{
  "id": "kraamzorg-fluxo-teste-001",
  "name": "Kraamzorg - Fluxo de Teste de Importação",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "teste-importacao",
        "authentication": "none",
        "responseMode": "onReceived",
        "options": {}
      },
      "id": "11111111-1111-1111-1111-111111111101",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.1,
      "position": [-1400, 0],
      "webhookId": "22222222-2222-2222-2222-222222222201"
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const jid = $input.first().json.chatid;\nreturn [{ json: { jid, conversa_id: jid, texto: 'ola' } }];"
      },
      "id": "11111111-1111-1111-1111-111111111102",
      "name": "Extrair Dados",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-1200, 0]
    },
    {
      "parameters": {
        "resource": "database",
        "operation": "executeQuery",
        "query": "select * from agente.registrar_mensagem($1, $2, $3, $4)",
        "options": {
          "queryReplacement": "={{ [$json.jid, $json.texto, 'entrada', 'cliente'] }}"
        }
      },
      "id": "11111111-1111-1111-1111-111111111103",
      "name": "Registrar Mensagem",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [-1000, 0],
      "credentials": {
        "postgres": {
          "id": "1",
          "name": "Postgres Kraamzorg (teste)"
        }
      }
    },
    {
      "parameters": {
        "inputSource": "workflowInputs",
        "workflowInputs": {
          "values": [
            { "name": "acao", "type": "string" },
            { "name": "wa_jid", "type": "string" },
            { "name": "conversa_id", "type": "string" },
            { "name": "dados", "type": "object" },
            { "name": "enviar_texto", "type": "boolean" }
          ]
        }
      },
      "id": "11111111-1111-1111-1111-111111111104",
      "name": "Gatilho Sub-fluxo",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.1,
      "position": [-1400, 300]
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "={{ $json.texto }}",
        "hasOutputParser": false,
        "needsFallback": false,
        "options": {
          "systemMessage": "Voce e a Isadora, assistente da Kraamzorg. Teste de importacao.",
          "maxIterations": 10,
          "returnIntermediateSteps": false
        }
      },
      "id": "11111111-1111-1111-1111-111111111105",
      "name": "Isadora",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "position": [-800, 0]
    },
    {
      "parameters": {
        "model": { "__rl": true, "mode": "list", "value": "gpt-4.1-mini" },
        "options": {
          "temperature": 0.5
        }
      },
      "id": "11111111-1111-1111-1111-111111111106",
      "name": "Modelo OpenAI",
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
      "typeVersion": 1.3,
      "position": [-800, 250],
      "credentials": {
        "openAiApi": {
          "id": "2",
          "name": "OpenAI Kraamzorg (teste)"
        }
      }
    },
    {
      "parameters": {
        "sessionIdType": "customKey",
        "sessionKey": "={{ $json.conversa_id }}",
        "tableName": "agente_n8n.chat_memoria",
        "contextWindowLength": 30
      },
      "id": "11111111-1111-1111-1111-111111111107",
      "name": "Memoria Postgres",
      "type": "@n8n/n8n-nodes-langchain.memoryPostgresChat",
      "typeVersion": 1.4,
      "position": [-650, 250],
      "credentials": {
        "postgres": {
          "id": "1",
          "name": "Postgres Kraamzorg (teste)"
        }
      }
    },
    {
      "parameters": {
        "model": "text-embedding-3-small",
        "options": {}
      },
      "id": "11111111-1111-1111-1111-111111111108",
      "name": "Embeddings OpenAI",
      "type": "@n8n/n8n-nodes-langchain.embeddingsOpenAi",
      "typeVersion": 1.2,
      "position": [-500, 500],
      "credentials": {
        "openAiApi": {
          "id": "2",
          "name": "OpenAI Kraamzorg (teste)"
        }
      }
    },
    {
      "parameters": {
        "mode": "retrieve-as-tool",
        "toolDescription": "Busca respostas na base de conhecimento aprovada.",
        "tableName": "agente_n8n.documentos",
        "topK": 5,
        "includeDocumentMetadata": true,
        "useReranker": false,
        "options": {
          "columnNames": {
            "values": {
              "idColumnName": "id",
              "vectorColumnName": "embedding",
              "contentColumnName": "text",
              "metadataColumnName": "metadata"
            }
          },
          "distanceStrategy": "cosine"
        }
      },
      "id": "11111111-1111-1111-1111-111111111109",
      "name": "base_conhecimento",
      "type": "@n8n/n8n-nodes-langchain.vectorStorePGVector",
      "typeVersion": 1.3,
      "position": [-650, 500],
      "credentials": {
        "postgres": {
          "id": "1",
          "name": "Postgres Kraamzorg (teste)"
        }
      }
    }
  ],
  "connections": {
    "Webhook": {
      "main": [
        [{ "node": "Extrair Dados", "type": "main", "index": 0 }]
      ]
    },
    "Extrair Dados": {
      "main": [
        [
          { "node": "Registrar Mensagem", "type": "main", "index": 0 },
          { "node": "Isadora", "type": "main", "index": 0 }
        ]
      ]
    },
    "Modelo OpenAI": {
      "ai_languageModel": [
        [{ "node": "Isadora", "type": "ai_languageModel", "index": 0 }]
      ]
    },
    "Memoria Postgres": {
      "ai_memory": [
        [{ "node": "Isadora", "type": "ai_memory", "index": 0 }]
      ]
    },
    "base_conhecimento": {
      "ai_tool": [
        [{ "node": "Isadora", "type": "ai_tool", "index": 0 }]
      ]
    },
    "Embeddings OpenAI": {
      "ai_embedding": [
        [{ "node": "base_conhecimento", "type": "ai_embedding", "index": 0 }]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}
