# Modelo de variáveis de ambiente do Kraamzorg OS. Copie para .env.local e
# preencha com valores do cofre da Kraamzorg (nunca valores reais aqui).
# "Só do servidor" quer dizer: nunca prefixado com NEXT_PUBLIC_, nunca chega
# ao navegador nem ao n8n (CLAUDE.md, "Segurança e LGPD").

# --- Supabase ---------------------------------------------------------------

# URL do projeto Supabase. Usada no cliente de servidor e no navegador.
NEXT_PUBLIC_SUPABASE_URL=

# Chave anônima do Supabase, respeita RLS. Usada no cliente de servidor e no
# navegador.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Chave service_role do Supabase, ignora RLS. Só do servidor: rotas de API e
# jobs de src/lib/db (cliente de serviço), nunca no navegador e nunca no n8n.
SUPABASE_SERVICE_ROLE_KEY=

# --- Resend (e-mail transacional) -------------------------------------------

# Chave de API do Resend. Só do servidor: envio de evoluções aos médicos e
# alertas de reserva (src/lib/messaging).
RESEND_API_KEY=

# --- OpenAI ------------------------------------------------------------------

# Chave de API da OpenAI. Só do servidor: usada pelos fluxos n8n (conversa,
# classificação, embeddings e transcrição da Isadora) e por rotas do app que
# chamam IA fora do n8n.
OPENAI_API_KEY=

# --- Autentique (assinatura eletrônica) --------------------------------------

# Token de API da Autentique (GraphQL v2). Só do servidor: envio do contrato
# para assinatura (P31).
AUTENTIQUE_API_TOKEN=

# Segredo no caminho da rota de webhook (/api/webhooks/autentique/[segredo]),
# cadastrado no painel da Autentique. Só do servidor. Não substitui a
# reconsulta do documento pela API antes de mudar qualquer estado (P31).
AUTENTIQUE_WEBHOOK_SECRET=

# Sandbox da Autentique (PRD 14, "Sandbox em homologação"). Só do servidor.
# Qualquer valor diferente de "false" mantém o sandbox ligado; só produção
# define "false".
AUTENTIQUE_SANDBOX=

# --- InfinitePay (cobrança) --------------------------------------------------

# InfiniteTag da conta InfinitePay usada no Checkout. Só do servidor: geração
# do link de cobrança (P32).
INFINITEPAY_HANDLE=

# Chave de API/webhook da InfinitePay, usada para consultar payment_check
# porque o webhook não traz assinatura. Só do servidor. [conferir] Opcional:
# o Checkout público autentica só pelo handle; sem valor, o cabeçalho
# Authorization não é enviado (T-06 decide se o Plano de Cobrança exige).
INFINITEPAY_API_KEY=

# --- NFS-e (nota fiscal de serviço) ------------------------------------------

# [confirmar] URL base do provedor com suporte ao Emissor Nacional (T-05):
# a Kraamzorg nunca emitiu certificado A1 e a contadora ainda vai indicar o
# provedor. Só do servidor (P43).
NFSE_PROVEDOR_BASE_URL=

# Chave de API do provedor de NFS-e. Só do servidor (P43).
NFSE_PROVEDOR_API_KEY=

# --- Cloudflare Turnstile (captcha dos formulários públicos) ----------------

# Site key do Turnstile. Usada no navegador, nos formulários de
# src/app/(publico).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Secret key do Turnstile. Só do servidor: validação do token recebido do
# formulário antes de aceitar o envio.
TURNSTILE_SECRET_KEY=

# --- Sentry (observabilidade de erro) ----------------------------------------

# DSN do Sentry. Pode ir ao navegador (identifica só o projeto, não
# autentica nada); usado no app e, opcionalmente, nas funções de servidor.
NEXT_PUBLIC_SENTRY_DSN=

# Token de autenticação do Sentry para upload de source maps. Só do
# servidor, usado apenas em CI/build, nunca em runtime do app.
SENTRY_AUTH_TOKEN=

# --- Segredos internos --------------------------------------------------------

# Segredo comparado pelas rotas de cron (chamadas por pg_cron/pg_net) antes
# de executar qualquer tarefa agendada. Só do servidor.
CRON_SECRET=

# Segredo comparado pelas rotas internas que o próprio n8n ou outro serviço
# de confiança chama (por exemplo notificações internas). Só do servidor.
INTERNAL_ROUTES_SECRET=

# --- Web Push (VAPID) ---------------------------------------------------------

# Chave pública VAPID. Vai ao navegador: usada pelo service worker para
# assinar a inscrição de push (P11).
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# Chave privada VAPID. Só do servidor: assina o envio das notificações push.
VAPID_PRIVATE_KEY=

# Contato do assinante VAPID (mailto: ou https://), exigido pelo protocolo
# Web Push. Só do servidor.
VAPID_SUBJECT=

# --- Ambiente (P10) ------------------------------------------------------------

# Identifica o ambiente atual: "desenvolvimento", "homologacao" ou
# "producao" (P14 define o valor real em cada ambiente do Vercel). Vai ao
# navegador. Usada só para decidir o que aparece fora de produção, como a
# rota /design-system (CLAUDE.md, "Design"); nenhuma regra de negócio lê
# esta variável. Sem valor, o app assume "desenvolvimento".
NEXT_PUBLIC_APP_ENV=
